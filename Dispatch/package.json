{
  "name": "dispatch",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run dev:web",
    "dev:web": "npm run wasm:build && vite --mode web",
    "dev:desktop-ui": "vite --mode desktop",
    "build": "npm run build:web",
    "build:web": "npm run wasm:build && tsc -b && vite build --mode web",
    "build:web:frontend": "tsc -b && vite build --mode web",
    "build:desktop-ui": "tsc -b && vite build --mode desktop",
    "wasm:build": "wasm-pack build rust/dispatch-web-wasm --target web --out-dir ../../src/platform/web/wasm --out-name dispatch_web_wasm",
    "test:rust": "cargo test --workspace --locked && cargo test --manifest-path src-tauri/Cargo.toml --locked",
    "check": "npm run lint && npm run test:rust && npm run build:web && npm run build:desktop-ui",
    "tauri": "tauri",
    "lint": "eslint .",
    "preview": "npm run preview:web",
    "preview:web": "vite preview --outDir dist/web",
    "preview:desktop": "vite preview --outDir dist/desktop"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.1"
  }
}
